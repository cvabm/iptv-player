<?xml version="1.0" encoding="utf-8"?>
<!-- Deep gradient plate for premium feel -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FF0B1426"
                android:centerColor="#FF152A4A"
                android:endColor="#FF1A3A6B"
                android:type="linear" />
        </shape>
    </item>
    <!-- soft vignette corners -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="78%p"
                android:centerX="0.35"
                android:centerY="0.3"
                android:startColor="#33FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
